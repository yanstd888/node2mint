# Environment variables for Node2Mint Gateway
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets!

# Database — gunakan connection string PostgreSQL penuh
DATABASE_URL=postgresql://aiuser:PASSWORD@localhost:5432/aisell?sslmode=disable

# Redis — alamat untuk rate limiting
REDIS_ADDR=localhost:6379
# Sandi Redis (docker-compose memakai file gateway/.secrets/REDIS_PASSWORD).
# Wajib sama dengan yang dibaca container; kosong = tanpa auth, hanya untuk dev lama.
REDIS_PASSWORD=

# Rate limit — default AMAN adalah hidup. Set 'true' HANYA di dev: Docker
# Desktop di Windows menyatukan trafik browser jadi satu IP bridge, sehingga
# jatah per-IP saling habis. Di produksi biarkan kosong/false.
# RATE_LIMIT_DISABLE=false

# Monitor uptime — default menolak host non-publik (SSRF: gateway jadi proksi
# probe ke jaringan internal). Set 'true' HANYA di dev untuk memantau
# gateway/db sendiri dari dalam jaringan Docker.
# UPTIME_ALLOW_INTERNAL=false

# JWT Secret + encryption key — keduanya WAJIB, minimal 32 karakter.
# Generate masing-masing: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_32_CHAR_STRING

# Port server (default: 8080)
PORT=8080

# CORS — origin frontend yang diizinkan (default: http://localhost:5000)
CORS_ORIGIN=http://localhost:5000
# Admin IP allowlist (comma-separated CIDR). Kosong = semua IP (gunakan ini di dev/local
# di mana admin perlu akses dari IP dinamis). Contoh: ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.1.0/24
ADMIN_IP_ALLOWLIST=

# Uptime Kuma — dashboard health/uptime (container di docker-compose.yml).
# Isi UPTIME_KUMA_TOKEN dengan push token dari monitor bertipe "Push" di UI Kuma
# (http://localhost:3001 → Add New Monitor → Type: Push). Token dikosongkan =
# fitur push mati; Kuma tetap jalan sebagai dashboard mandiri.
UPTIME_KUMA_URL=http://uptime-kuma:3001
UPTIME_KUMA_TOKEN=
# Stripe (opsional — kosong = top-up manual saja, endpoint balik 503 jelas):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Turnstile (opsional; isi keduanya agar login/daftar wajib lolos captcha) --
# Buat widget Cloudflare Turnstile untuk localhost (dev) atau host produksi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=www.node2mint.com

# --- Login sosial (opsional; kosong = tombol provider disembunyikan web) ----
# Google Cloud Console > Credentials > OAuth client (Web). Callback:
#   http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram OIDC/Web Login (berbeda dari TELEGRAM_BOT_TOKEN). Isi keduanya.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Telegram Bot API membership gate/seller notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Telegram join-gate / seller bot. Chat ID may be @node2mint or the numeric chat ID.
TELEGRAM_CHAT_ID=@node2mint
TELEGRAM_WEBHOOK_SECRET=
# Telegram admin destination for operational alerts (chat ID; never commit a real value).
TELEGRAM_ADMIN_CHAT_ID=
# Alamat web & API publik (dipakai redirect OAuth + redirect_uri).
PUBLIC_WEB_URL=http://localhost:5000
PUBLIC_API_URL=http://localhost:8080

# --- SendPulse transactional email (optional; queued emails stay pending when blank) ---
# Bodies are rendered as HTML by the gateway, so no provider template IDs exist.
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
EMAIL_SENDER_EMAIL=support@node2mint.com
EMAIL_SENDER_NAME=Node2Mint

# Fixed IDR/USDT rate for invoices; replace with a trusted pricing service before production.
CRYPTO_IDR_PER_USDT=
# USDT TRC-20 receiving wallet and TronGrid watcher.
CRYPTO_TRON_ADDRESS=
CRYPTO_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
CRYPTO_TRONGRID_API_KEY=